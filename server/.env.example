# Server only. Copy to server/.env and set your Atlas connection string.
MONGODB_URI=
MONGODB_DB=salon
PORT=3001
# Optional for npm run staff:create. Use an individual work email and a
# password of 15–128 characters, then remove these provisioning variables.
STAFF_SETUP_EMAIL=
STAFF_SETUP_PASSWORD=
# Set this to the assigned barber slug for npm run staff:create-barber.
STAFF_SETUP_BARBER=
