{
  "name": "salon-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=server/.env --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=server/.env server/index.js",
    "seed": "node --env-file-if-exists=server/.env server/seed.js",
    "seed:reception": "node --env-file-if-exists=server/.env server/seed-reception.js",
    "staff:create": "node --env-file-if-exists=server/.env server/create-receptionist.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}
